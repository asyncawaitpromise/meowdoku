{
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development concurrently -n server,client 'nodemon index.mjs' 'pnpm --prefix client dev'",
    "dev:local": "nodemon dev-local.mjs",
    "build": "pnpm --prefix client build",
    "serve": "node index.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "test": "vitest run",
    "test:quick": "vitest run --exclude='test/benchmarks/**'",
    "test:bench": "vitest run --config vitest.bench.config.ts",
    "test:all": "vitest run --exclude='test/benchmarks/**' && vitest run --config vitest.bench.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemon": "^3.1.10"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "supertest": "^7.2.2",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
